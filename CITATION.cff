cff-version: 1.2.0
message: "If you use bonefish, please cite it as below, together with minimap2."
title: "bonefish: a fast aligner for Oxford Nanopore and PacBio HiFi reads"
type: software
authors:
  - family-names: Costo
    given-names: Dylan
version: 0.4.0
date-released: 2026-10-28
license: MIT
repository-code: "https://github.com/DylanCosto/bonefish"
keywords:
  - Oxford Nanopore
  - PacBio HiFi
  - long reads
  - sequence alignment
  - variant calling
  - methylation
  - RNA-seq
  - spliced alignment
references:
  - type: article
    title: "Minimap2: pairwise alignment for nucleotide sequences"
    authors:
      - family-names: Li
        given-names: Heng
    journal: Bioinformatics
    volume: 34
    issue: 18
    start: 3094
    end: 3100
    year: 2018
    doi: 10.1093/bioinformatics/bty191
  - type: software
    title: rammap
    repository-code: "https://github.com/jwanglab/rammap"
    notes: "Rust reimplementation of minimap2 that bonefish is forked from."
