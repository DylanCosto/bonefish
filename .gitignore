# Rust build artifacts (workspace-wide; Cargo.lock IS committed — this is a binary crate)
/target
**/target

# wasm-pack build output (generated at repo root by scripts/build-wasm, see docs/upstream-rammap/wasm.md)
/pkg

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# OS cruft
.DS_Store
Thumbs.db

# Local cargo config overrides (keep the committed .cargo/config.toml, ignore personal overrides)
.cargo/config.local.toml

# Extra cargo target dirs used for local experiments and profiling (target-native, target-prof, ...)
/target-*/

# Release packages built by scripts/package-release.sh
/dist/

# Python validation helpers
__pycache__/
